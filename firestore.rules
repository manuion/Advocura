rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollections under users - accessible only by the user
      match /clients/{clientId} {
        allow read, write, create, delete: if isOwner(userId);
      }

      match /cases/{caseId} {
        allow read, write, create, delete: if isOwner(userId);
      }

      match /documents/{documentId} {
        allow read, write, create, delete: if isOwner(userId);
      }

      match /hearings/{hearingId} {
        allow read, write, create, delete: if isOwner(userId);
      }
    }

    // Config collection - read-only for authenticated users
    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if false; // Only admins via Firebase Console
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
